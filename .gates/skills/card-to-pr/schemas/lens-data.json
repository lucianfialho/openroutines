{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "card-to-pr revisao data/Prisma lens output",
  "type": "object",
  "required": ["approved", "gaps"],
  "properties": {
    "approved": { "type": "boolean" },
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["description", "contestable"],
        "properties": {
          "description": { "type": "string" },
          "file": { "type": "string" },
          "line": { "type": "number" },
          "contestable": { "type": "boolean" }
        }
      }
    }
  }
}
