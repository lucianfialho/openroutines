# === OpenRoutines Environment ===

# Providers run CLI-FIRST (Bloco 2): the pipeline drives the logged-in `claude`
# and `kimi` CLIs headless — NO API key required. Log in once on the machine
# (`claude setup-token`, kimi login). The two keys below are OPT-IN upgrades:
#  - KIMI_API_KEY switches the default Kimi provider to the billed Coding API.
#  - ANTHROPIC_API_KEY makes the security/architecture judges use the billed
#    Claude API (restoring the strict resp.model anti-bypass); absent, they run
#    on the same headless `claude` CLI with a verdict prompt.
# Get a Kimi key at: https://www.kimi.com/code/console
# KIMI_API_KEY=sk-your-kimi-code-key
KIMI_MODEL=kimi-coding/k2p5
# ANTHROPIC_API_KEY=sk-ant-...

# GitHub Connector & Webhook.
# GITHUB_TOKEN cobre TODOS os repos atendidos (fine-grained PAT: contents:rw +
# pull_requests:rw, e Administration:read para o preflight de branch protection).
# GITHUB_REPO é LEGADO: usado só pelo solve-issue (dogfooding do próprio
# OpenRoutines) e pelo registro dos github tools — o card-to-pr sempre resolve o
# repo via repos.yaml (F3 #148), nunca por esta variável única.
GITHUB_TOKEN=ghp_...
GITHUB_REPO=owner/repo
GITHUB_WEBHOOK_SECRET=supersecreto123

# Trello Connector (task-sources.yaml, type: trello)
# Get your key + token at: https://trello.com/power-ups/admin
TRELLO_API_KEY=your-trello-api-key
TRELLO_API_TOKEN=your-trello-api-token
# Human steering via 🧭 comments (F5 #169) — Trello member ids/usernames allowed
# to steer; empty/absent means NO steering is ever applied (fails safe).
# TRELLO_STEERING_WHITELIST=member-id-or-username,another

# Persistence (Neon serverless PostgreSQL for Vercel)
# Get yours at: https://neon.tech
DATABASE_URL=postgresql://user:pass@host.neon.tech/db?sslmode=require

# Optional: Redis for BullMQ queue (not used in Vercel serverless)
# REDIS_URL=redis://localhost:6379

# Auth for mutating orchestrator routes (/trigger, /gates/*, /skills, ...).
# Send it as `Authorization: Bearer <token>`. Requests are also accepted when a
# non-empty `Tailscale-User-Login` header is present (injected by `tailscale
# serve`). With neither, every mutating route fails closed with 401.
OPENROUTINES_API_TOKEN=change-me-long-random-secret

# Enable the legacy ReAct micro-tools (filesystem + git worktree, incl.
# run_shell). Required while `solve-issue` is the only skill (pre-F1); set to 1.
# Leave unset once skills migrate to the Claude Code CLI executor (F1).
OPENROUTINES_LEGACY_TOOLS=1

# Timezone — cron schedules assume this zone (e.g. the 01:00 night run).
TZ=America/Sao_Paulo

# Bind host (default 127.0.0.1 loopback). Set 0.0.0.0 only for direct LAN/public
# exposure (not needed behind `tailscale serve`).
# HOST=127.0.0.1

# Local dev only
PORT=3000
ROUTINES_DIR=./routines
SKILLS_DIR=./.gates/skills
TASK_SOURCES_FILE=./task-sources.yaml

# Night coordinator (F3 #147) — the unattended night-run window.
NIGHT_WINDOW_START=01:00
NIGHT_WINDOW_END=06:30
# Night budget and PR caps moved to policy.yaml (F5 #168): night.budget_usd,
# night.max_prs_per_night, backpressure.max_open_prs_per_repo. Edit them there.
# BullMQ worker concurrency during the night window (default 2, max 3) — bounds
# how many cards run in parallel; the coordinator's own claim batches use the
# same number.
NIGHT_PARALLELISM=2

# Telegram alert (D22, F4 #186) — blockReason: seguranca* e falha do night-run.
# Crie um bot com @BotFather; pegue o chat_id mandando /start pro bot e
# consultando https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

# Multi-repo registry (F3 #148) — name -> clone/branch/verify config.
REPOS_REGISTRY_PATH=./repos.yaml
# Bloco 1 — resolve a card's repo by NAME under this base dir (your clones live
# here, e.g. /Volumes/programacao/<repo>). Makes repos.yaml OPTIONAL: a repo with
# no entry resolves to REPOS_BASE_DIR/<name> and is auto-discovered (githubRepo/
# base branch/verify read off the real clone).
# REPOS_BASE_DIR=/Volumes/programacao
# Owners a card may name a repo NOT yet cloned from; the system clones it lazily
# via `gh repo clone` (gh's own auth) into REPOS_BASE_DIR. Empty = never clone an
# unknown repo (only pre-cloned/discovered repos run). The GITHUB_TOKEN's own
# scope is the ultimate boundary — a repo it can't see 404s and never clones.
# ALLOWED_REPO_OWNERS=lucianfialho

# Autonomous work generation (F5 #164, D26) — Sunday-maintenance proposeWeeklyCards().
# The weekly proposal cap lives in policy.yaml (day.max_auto_proposed_cards_per_week).
# CVE crítico opt-in: "true" queues the card directly in OpenRoutines — Fila,
# bypassing Backlog. Default false — even a critical CVE just lands in Backlog.
# AUTO_QUEUE_SECURITY_PATCHES=false
# Base dir for per-card git worktrees (F3 #146/#149). The boot reconciliation's
# `git reset --hard` is fenced to this path — never a real clone.
WORKTREE_BASE=/tmp/or-worktrees
# NOTE: POST /trigger/* auth uses OPENROUTINES_API_TOKEN (above), not a separate
# TRIGGER_AUTH_TOKEN (the F3 #152 issue's assumed name — the real one is here).
